# Copy to backend/.env for local dev, or set these as Environment Variables in Vercel.

# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.mongodb.net)
MONGO_URL=
DB_NAME=

# Comma-separated list of origins allowed for cross-origin requests with credentials.
# Leave empty when frontend + backend share one Vercel domain (recommended) — same-origin
# requests aren't subject to CORS at all.
CORS_ORIGINS=

# Random secret Vercel Cron sends back as "Authorization: Bearer <value>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Seals Google Drive links in public content (lib/media.py). Set the SAME value on the
# frontend Vercel project too — its /media and album functions open the sealed links.
# Generate with: openssl rand -hex 32
MEDIA_KEY=

# Weekly report (currently simulated — Resend not wired to a live key)
REPORT_TIMEZONE=Asia/Jakarta
REPORT_RECIPIENT=pimpinan@example.com
REPORT_SENDER=onboarding@resend.dev

# Only read by backend/seed.py — set to strong unique passwords before running the seed
# script against a real deployment. If unset, seed.py falls back to the old committed
# defaults (which are public in this repo's git history) and prints a warning.
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
SEED_PPDB_PASSWORD=
SEED_AGENDA_PASSWORD=
