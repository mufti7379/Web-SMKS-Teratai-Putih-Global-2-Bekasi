{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/berita", "destination": "/api/page?route=list" },
    { "source": "/berita/:bulan/:tahun/:slug", "destination": "/api/page?route=article&bulan=:bulan&tahun=:tahun&slug=:slug" },
    { "source": "/berita/:id", "destination": "/api/page?route=legacy&id=:id" },
    { "source": "/galeri/:album", "destination": "/api/page?route=album&album=:album" },
    { "source": "/data/album/:album", "destination": "/api/album?album=:album" },
    { "source": "/media/preview/:token", "destination": "/api/media?token=:token&preview=1" },
    { "source": "/media/:token", "destination": "/api/media?token=:token" },
    { "source": "/api/(.*)", "destination": "https://terataiputih2-backend.vercel.app/api/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/hero-preview", "destination": "/index.html" }
  ]
}
